# Git source release. Allow only the project sources and release inputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Build-Windows-Release.cmd
!/build_windows_release.ps1
!/Build-Installer.cmd
!/build_installer.ps1
!/Wanderer.iss

!/Wanderer/
/Wanderer/*
!/Wanderer/Source/
!/Wanderer/Wanderer.uproject
!/Wanderer/Config/
/Wanderer/Config/*
!/Wanderer/Config/DefaultEngine.ini
!/Wanderer/Config/DefaultGame.ini
!/Wanderer/Config/DefaultInput.ini

# Keep the README's linked video cover.
!/Docs/
/Docs/*
!/Docs/Images/
/Docs/Images/*
!/Docs/Images/showcase-cover-play.jpg

# Exclude dependencies, generated files, and local credentials.
**/Plugins/
**/Content/
**/Binaries/
**/Build/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/.vs/
**/__pycache__/
**/.env
**/.env.*
**/auth.json
**/*.secret
**/credentials/
**/cookies/
**/secrets/
**/*.uasset
**/*.umap
**/*.pyc
**/*.dll
**/*.exe
**/*.pdb
**/*.bnk
**/*.wem
